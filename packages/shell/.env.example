# MFE URLs used by the Next.js shell to load remote entries.
# In development these default to localhost ports (see next.config.js).
# Set these in production to point at your deployed MFE hosts.
NEXT_PUBLIC_MFE_REACT_URL=https://mfe-react.example.com
NEXT_PUBLIC_MFE_VUE_URL=https://mfe-vue.example.com
NEXT_PUBLIC_MFE_ANGULAR_URL=https://mfe-angular.example.com
